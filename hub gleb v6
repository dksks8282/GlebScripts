-- ФУНКЦИЯ СОЗДАНИЯ КНОПОК (С ФИКСОМ ДЛЯ ПЛАНШЕТА)
local function createBtn(name, url, color)
    local b = Instance.new("TextButton", scroll)
    b.Size = UDim2.new(0.95, 0, 0, 50)
    b.Text = name
    b.BackgroundColor3 = color or Color3.fromRGB(50, 50, 50)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    Instance.new("UICorner", b)
    
    -- Используем MouseButton1Down для моментального срабатывания
    b.MouseButton1Down:Connect(function()
        print("Глеб запускает: " .. name)
        -- Если это Ангел или Гость, сначала грузим клавиатуру
        if name:find("MORPH") or name:find("ANGEL") or name:find("GUEST") then
            loadstring(game:HttpGet("https://rawscripts.net/raw/Universal-Script-delta-keyboard-crack-reupload-20074"))()
            task.wait(1.5)
        end
        loadstring(game:HttpGet(url))()
    end)
end

